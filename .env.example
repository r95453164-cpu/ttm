# .env.example - TikTok Custom
# Не храните пароли в исходном коде!

# Backend
PYTHONUNBUFFERED=1
DEBUG=True
SECRET_KEY=super-secret-change-me
JWT_SECRET_KEY=change-me-securely
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db:5432/ttm_db

# Redis
REDIS_URL=redis://redis:6379/0

# Object Storage (S3-compatible / MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET_NAME=ttm-emojis

# RU Connectivity (Динамический эндпоинт)
API_ENDPOINT=https://api.ttm.local
BACKUP_API_ENDPOINT=https://backup.ttm.local
ENABLE_RU_DIAGNOSTICS=True

# iOS App Config (для синхронизации)
IOS_BUNDLE_ID=com.ttm.tiktokcustom
MIN_IOS_VERSION=17.0

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-securely
